---
import { site } from '../data/site';

// Dark closing CTA panel (blockmob-style), theme-aware contact button.
interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
const web3 = base === '/web3';
const primary = web3
  ? { label: 'Message us on Telegram', href: site.telegram }
  : { label: 'Message us on WhatsApp', href: site.whatsapp };
---

<div class="px-6 py-[90px] lg:px-[75px]">
  <section class="cta-panel relative mx-auto flex min-h-[320px] w-full max-w-[1050px] flex-col items-center justify-center gap-7 overflow-hidden rounded-[48px] px-8 py-16 text-center">
    <h2 class="m-0 max-w-[560px] font-exo text-[26px] font-medium leading-snug text-white md:text-[28px]">
      If you scrolled this far, let's build something.
    </h2>
    <div class="flex flex-col items-center gap-[15px] sm:flex-row">
      <a href={primary.href} target="_blank" rel="noopener noreferrer" class={`btn btn-accent font-exo ${web3 ? 'glow-pulse' : ''}`}>{primary.label}</a>
      <a href={`mailto:${site.email}`} class="btn btn-ghost font-exo">{site.email}</a>
    </div>
    <p class="m-0 font-exo text-[13px] text-white/60">No pitch. No pressure. Just a conversation.</p>
  </section>
</div>

<style>
  .cta-panel {
    background:
      radial-gradient(ellipse 70% 90% at 50% -20%, rgb(var(--accent-rgb) / 0.35), transparent 65%),
      #0b030e;
  }
</style>

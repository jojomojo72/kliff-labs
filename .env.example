# Admin login — required in production. In dev, if unset, the panel accepts
# admin@kliff.io / kliff (dev-only fallback, never active in prod builds).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase content backend — optional locally, required for saving in
# production (serverless filesystems are read-only). Without these, the
# admin reads and writes src/data/blogs.json and src/data/projects.json.
# Schema: supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

---
import type { Project } from '../data/projects';

// noir.io work card: 3:2 visual tile with an "In progress" pill overlay,
// then a "Title — tagline" caption row, whole card cover-linked when live.
// Blockmob-style what-was-done line sits under the caption (per plan).
interface Props {
  project: Project;
}
const { project } = Astro.props;
const inProgress = project.status === 'in-progress';
const web3 = project.category === 'Web3';
const initials = project.title
  .split(/\s+/)
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<article class="work-card group relative" data-cat={project.category}>
  <div class={`tile relative overflow-hidden rounded-2xl border border-[var(--hairline-solid)] ${web3 ? 'tile-web3' : 'tile-accent'}`}>
    <span class="tile-mark font-phudu" aria-hidden="true">{initials}</span>
    {inProgress && (
      <span class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-full border border-[var(--hairline-solid)] bg-white/90 px-3 py-1.5 font-exo text-[13px] font-medium text-ink backdrop-blur">
        <span class={`h-2 w-2 rounded-full ${web3 ? 'bg-[#8736d9]' : 'bg-[var(--accent)]'} prog-dot`}></span>
        In progress
      </span>
    )}
  </div>

  <div class="mt-3 flex items-baseline justify-between gap-3">
    <h3 class="m-0 font-exo text-[17px] font-normal leading-snug">
      <span class="font-semibold text-ink">{project.title}</span>
      <span class="text-muted"> — {project.tagline}</span>
    </h3>
    <span class="shrink-0 font-exo text-[12px] font-semibold uppercase tracking-[0.1em] text-muted">{project.year}</span>
  </div>
  <p class="m-0 mt-1 font-exo text-[13px] leading-relaxed text-muted">
    {project.work.join(' · ')} · {project.stack.join(', ')}
  </p>

  {!inProgress && project.link && (
    <a href={project.link} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-10" aria-label={`${project.title} — ${project.tagline}`}></a>
  )}
</article>

<style>
  .tile {
    aspect-ratio: 3 / 2;
  }
  .tile-accent {
    background:
      radial-gradient(ellipse 90% 90% at 20% 0%, rgb(var(--accent-rgb) / 0.28), transparent 60%),
      linear-gradient(155deg, rgb(var(--accent-rgb) / 0.16), rgb(var(--accent-rgb) / 0.04));
  }
  .tile-web3 {
    background:
      radial-gradient(ellipse 90% 90% at 20% 0%, rgba(135, 54, 217, 0.3), transparent 60%),
      linear-gradient(155deg, rgba(135, 54, 217, 0.18), rgba(135, 54, 217, 0.04));
  }
  .tile-mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: clamp(56px, 8vw, 96px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgb(var(--accent-rgb) / 0.35);
    transition: transform 0.35s ease;
  }
  .tile-web3 .tile-mark {
    color: rgba(135, 54, 217, 0.38);
  }
  .work-card:hover .tile-mark {
    transform: scale(1.06);
  }
  .prog-dot {
    animation: progPulse 2s ease-in-out infinite;
  }
  @keyframes progPulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prog-dot {
      animation: none;
    }
    .work-card:hover .tile-mark {
      transform: none;
    }
  }
</style>

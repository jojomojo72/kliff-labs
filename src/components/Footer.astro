---
import Logo from './Logo.astro';
import { site } from '../data/site';

// Footer structured exactly like noir.io's:
//   [Subscribe to us | divider | email pill form]
//   [Social column | Connect column]
//   [giant logo]
//   [© years | locations | arrow-circle socials + labeled contact]
// Per plan: bottom-right contact says WhatsApp on kliff.io, Telegram on web3.
interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
const web3 = base === '/web3';
const contact = web3
  ? { label: 'Telegram', href: site.telegram }
  : { label: 'WhatsApp', href: site.whatsapp };
const connectLinks = [
  contact,
  { label: 'New Business', href: `mailto:${site.email}?subject=New%20Business` },
  { label: 'Careers', href: `mailto:${site.email}?subject=Careers%20at%20Kliff` },
];
const socialLinks = [
  { label: 'Instagram', href: site.instagram },
  { label: 'X.com', href: site.x },
  { label: 'LinkedIn', href: site.linkedin },
];
const circleLinks = [...socialLinks.map((s) => ({ ...s })), contact];
---

<footer class="font-exo" id="footer">
  <!-- subscribe row -->
  <div class="dashed-x flex flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center lg:px-[75px]">
    <h2 class="m-0 text-[24px] font-normal text-ink md:text-[26px]">Subscribe to us</h2>
    <div class="hidden flex-1 border-t border-dashed border-[var(--hairline-solid)] sm:block" aria-hidden="true"></div>
    <!-- ponytail: opens a prefilled mailto; wire to a real ESP when one exists -->
    <form id="subscribe-form" class="flex h-[54px] w-full max-w-[360px] items-center rounded-full border border-[var(--hairline-solid)] bg-white pl-5 pr-1.5">
      <input
        type="email"
        required
        placeholder="Email address"
        class="h-full w-full border-0 bg-transparent text-[15px] text-ink outline-none placeholder:text-muted"
      />
      <button type="submit" aria-label="Subscribe" class="grid h-[42px] w-[42px] shrink-0 place-items-center rounded-full bg-[var(--accent)] text-white transition-transform duration-200 hover:scale-105">
        <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M1.33 6h9.34M10.67 6 6 1.33M10.67 6 6 10.67" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </form>
  </div>

  <!-- link columns -->
  <div class="grid grid-cols-2 gap-8 px-6 py-10 sm:max-w-[560px] lg:px-[75px]">
    <div class="flex flex-col gap-3">
      <h6 class="m-0 text-[18px] font-medium text-ink md:text-[20px]">Social</h6>
      {socialLinks.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-[16px] text-muted transition-colors hover:text-ink md:text-[18px]">{l.label}</a>
      ))}
    </div>
    <div class="flex flex-col gap-3">
      <h6 class="m-0 text-[18px] font-medium text-ink md:text-[20px]">Connect</h6>
      {connectLinks.map((l) => (
        <a
          href={l.href}
          target={l.href.startsWith('mailto:') ? undefined : '_blank'}
          rel={l.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
          class="text-[16px] text-muted transition-colors hover:text-ink md:text-[18px]"
          >{l.label}</a
        >
      ))}
    </div>
  </div>

  <!-- giant logo -->
  <a href={base || '/'} class="watermark block px-6 lg:px-[75px]" aria-label="Home">
    <div class="watermark-text font-phudu">kliff<span class="labs">labs</span></div>
  </a>

  <!-- bottom bar -->
  <div class="flex flex-col items-center justify-between gap-4 px-6 py-6 text-[13px] uppercase tracking-[0.06em] text-muted sm:flex-row md:text-[14px] lg:px-[75px]">
    <p class="m-0">{site.copyright}</p>
    <p class="m-0">{site.locations}</p>
    <div class="flex items-center gap-2">
      {circleLinks.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={l.label}
          title={l.label}
          class="group grid h-10 w-10 place-items-center rounded-full border border-[var(--hairline-solid)] bg-white transition-colors hover:border-[var(--accent)] hover:bg-[var(--accent)] hover:text-white"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" class="-rotate-45 text-ink transition-colors group-hover:text-white">
            <path d="M1.33 6h9.34M10.67 6 6 1.33M10.67 6 6 10.67" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))}
      <a
        href={contact.href}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 rounded-full border border-[var(--accent)] px-4 py-2 font-semibold normal-case tracking-normal text-[var(--accent)] transition-colors hover:bg-[var(--accent)] hover:text-white"
        >{contact.label}</a
      >
    </div>
  </div>
</footer>

<style>
  .watermark {
    width: 100%;
    text-align: center;
    user-select: none;
    text-decoration: none;
  }
  .watermark-text {
    font-size: clamp(64px, 16vw, 240px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    white-space: nowrap;
    background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.22) 0%, rgb(var(--accent-rgb) / 0) 88%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: background 0.3s ease;
  }
  .watermark-text .labs {
    font-weight: 400;
  }
  .watermark:hover .watermark-text {
    background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.45) 0%, rgb(var(--accent-rgb) / 0.05) 88%);
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>

<script define:vars={{ email: site.email }}>
  const form = document.getElementById('subscribe-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const value = form.querySelector('input')?.value ?? '';
    window.location.href = `mailto:${email}?subject=Subscribe&body=${encodeURIComponent(value)}`;
  });
</script>
